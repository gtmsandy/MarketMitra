CORS_ORIGINS=http://localhost:5173

# Market data source: mock | postgres
MARKET_DATA_SOURCE=mock

# Required when MARKET_DATA_SOURCE=postgres
DATABASE_URL=postgresql://user:password@localhost:5432/marketmitra

# Optional authorized live provider; disabled by default.
LIVE_MARKET_ENABLED=false
NEPSE_PROVIDER_NAME=unconfigured
NEPSE_LIVE_API_URL=
NEPSE_LIVE_API_KEY=
NEPSE_LIVE_API_SECRET=
NEPSE_LIVE_ACCESS_ID=
NEPSE_LIVE_API_VERSION=1.0
LIVE_MARKET_POLL_INTERVAL_SECONDS=1
REPLAY_PERSIST_LIVE_QUOTES=false
