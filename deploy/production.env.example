# Non-secret production contract. Inject real secrets through the platform vault.
APP_ENV=production
MARKET_DATA_SOURCE=postgres
DATABASE_URL=postgresql://<database-user>:<injected-password>@<database-host>:5432/<database-name>?sslmode=verify-full
CORS_ORIGINS=https://<frontend-host>
TRUSTED_HOSTS=<api-host>,<health-check-host>

LIVE_MARKET_ENABLED=false
LIVE_MARKET_AUTHORIZED=false
LIVE_MARKET_PROVIDER=
NEPSE_PROVIDER_NAME=unconfigured
NEPSE_LIVE_API_URL=
NEPSE_LIVE_API_KEY=

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=5

HTTP_RATE_LIMIT_REQUESTS=120
HTTP_RATE_LIMIT_WINDOW_SECONDS=60
HTTP_RATE_LIMIT_MAX_CLIENTS=10000
WEBSOCKET_MAX_CONNECTIONS=100

# Change both to true only after HTTPS termination and proxy trust are verified.
HTTPS_DEPLOYMENT=false
HSTS_ENABLED=false
